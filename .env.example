DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 总管（owner）密码：默认 12345678，登录后台用它；
# 上线前务必改成自己的强密码（一次登录后可在后台「设置」里改，改完写进数据库）。
COUNSELOR_KEY=12345678

PORT=3000

# 敏感配置（API Key）加密用的主密钥。
# 生产环境务必设成一段随机串（>= 32 位），例如：openssl rand -hex 32
# 不设置的话会在 data/.secret 自动生成一个随机文件——容器换实例/重建目录就会丢失，
# 届时需要在后台重新填写 API Key。
SECRET_KEY=
