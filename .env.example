DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 总管（owner）账号：登录用户名固定为 owner，密码就是下面这一行（默认 12345678）。
# 上线前务必改成自己的强密码；登录后可在后台「设置」里改，改完写进数据库。
# 辅导员 / 助理账号由总管在后台创建：账号名自定（支持中文，如「王辅导员」），
# 初始密码一律 123456，提示本人登录后自行修改。
COUNSELOR_KEY=12345678

PORT=3000

# 敏感配置（API Key）加密用的主密钥。
# 生产环境务必设成一段随机串（>= 32 位），例如：openssl rand -hex 32
# 不设置的话会在 data/.secret 自动生成一个随机文件——容器换实例/重建目录就会丢失，
# 届时需要在后台重新填写 API Key。
SECRET_KEY=
